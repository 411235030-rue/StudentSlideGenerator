@page "/"
@inject DeckApiClient DeckGenerator
@inject IJSRuntime JS

<PageTitle>Slide Generator</PageTitle>

<section class="hero">
    <div class="hero-content">
        <p class="eyebrow">STUDENT SLIDE STUDIO</p>
        <h1>整理成簡報。</h1>
    </div>
</section>

<section class="workspace">
    <aside class="control-panel">
        <div class="panel-heading">
            <span class="step">01</span>
            <div>
                <h2>上傳文件</h2>
                <p>單檔上限 20 MB</p>
            </div>
        </div>

        <label class="upload-zone">
            <InputFile OnChange="HandleFileSelected"
                       accept=".pdf,.docx,.txt,.md" />
            <span class="upload-icon">↑</span>
            <strong>@(selectedFile?.Name ?? "選擇文件")</strong>
            <small>PDF · DOCX · TXT · MD</small>
        </label>

        @if (selectedFile is not null)
        {
            <div class="file-row">
                <div>
                    <strong>@selectedFile.Name</strong>
                    <small>@FormatBytes(selectedFile.Size)</small>
                </div>
                <button class="text-button" @onclick="ClearFile">移除</button>
            </div>
        }

        <label class="field-label" for="detailMode">內容深度</label>
        <select id="detailMode" class="text-input" @bind="detailMode">
            <option value="auto">自動判斷</option>
            <option value="concise">精簡版（6～8 頁）</option>
            <option value="standard">標準版（9～12 頁）</option>
            <option value="detailed">詳細版（13～18 頁）</option>
        </select>

        <button class="primary-button"
                disabled="@(selectedFile is null || isGenerating)"
                @onclick="GenerateDeck">
            @(isGenerating ? "正在整理內容…" : "產生簡報草稿")
        </button>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }

        <div class="privacy-note">
            <strong>Gemini 文件處理</strong>
            <p>PDF 會保留圖片與圖表脈絡；DOCX、TXT、MD 會先擷取文字，再送至 Gemini。</p>
        </div>
    </aside>

    <div class="preview-panel">
        @if (deck is null)
        {
            <div class="empty-state">
                <div class="empty-art">
                    <span></span><span></span><span></span>
                </div>
                <h2>你的簡報會顯示在這裡</h2>
                <p>先上傳一份教材，Gemini 會建立大綱並產生已排版的投影片。</p>
            </div>
        }
        else
        {
            <div class="preview-toolbar">
                <div>
                    <p class="eyebrow">LIVE PREVIEW</p>
                    <h2>@deck.Title</h2>
                </div>
                <div class="toolbar-actions">
                    <button class="secondary-button" @onclick="AddSlide">新增頁面</button>
                    <button class="secondary-button" @onclick="DownloadJson">下載 JSON</button>
                    <button class="primary-button compact" @onclick="DownloadHtml">下載 HTML 簡報</button>
                </div>
            </div>

            <div class="deck-editor" style="@BuildThemeStyle()">
                @for (var index = 0; index < deck.Slides.Count; index++)
                {
                    var slide = deck.Slides[index];
                    <article class="slide-card">
                        <div class="slide-number">@(index + 1).ToString("00")</div>
                        <div class="@($"slide-canvas layout-{slide.Layout} variant-{slide.BackgroundVariant}")">
                            <div class="slide-accent"></div>
                            <input class="section-label" @bind="slide.SectionLabel" />

                            @if (slide.Layout == "quote")
                            {
                                <textarea class="slide-quote" rows="5" @bind="slide.Content"></textarea>
                                <input class="slide-title quote-source" @bind="slide.Title" />
                            }
                            else
                            {
                                <input class="slide-title" @bind="slide.Title" />
                                <input class="slide-subtitle" @bind="slide.Subtitle" />

                                @if (slide.Layout == "two-column")
                                {
                                    var columns = SplitColumns(slide.Content);
                                    <div class="slide-columns">
                                        <textarea class="slide-body" rows="7" value="@columns.Left"
                                                  @onchange="eventArgs => UpdateColumn(slide, true, eventArgs.Value?.ToString())"></textarea>
                                        <textarea class="slide-body" rows="7" value="@columns.Right"
                                                  @onchange="eventArgs => UpdateColumn(slide, false, eventArgs.Value?.ToString())"></textarea>
                                    </div>
                                }
                                else
                                {
                                    <textarea class="slide-body"
                                              rows="7"
                                              @bind="slide.Content"></textarea>
                                }
                            }


                            <div class="slide-footer">
                                <span>@deck.Theme.StyleName · @deck.Audience</span>
                                <button class="delete-button"
                                        title="刪除此頁"
                                        @onclick="() => DeleteSlide(slide)">刪除</button>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>

@code {
    private const long MaxFileSize = 20 * 1024 * 1024;

    private IBrowserFile? selectedFile;
    private SlideDeck? deck;
    private string audience = "大學課堂報告";
    private string detailMode = "auto";
    private bool isGenerating;
    private string? errorMessage;

    private void HandleFileSelected(InputFileChangeEventArgs eventArgs)
    {
        errorMessage = null;
        deck = null;

        var file = eventArgs.File;
        if (file.Size > MaxFileSize)
        {
            selectedFile = null;
            errorMessage = "檔案超過 20 MB，請壓縮後再試一次。";
            return;
        }

        var extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".pdf" or ".docx" or ".txt" or ".md"))
        {
            selectedFile = null;
            errorMessage = "目前僅支援 PDF、DOCX、TXT 與 MD。";
            return;
        }

        selectedFile = file;
    }

    private void ClearFile()
    {
        selectedFile = null;
        deck = null;
        errorMessage = null;
    }

    private async Task GenerateDeck()
    {
        if (selectedFile is null)
        {
            return;
        }

        try
        {
            isGenerating = true;
            errorMessage = null;

            await using var source = selectedFile.OpenReadStream(MaxFileSize);
            using var buffer = new MemoryStream();
            await source.CopyToAsync(buffer);

            deck = await DeckGenerator.GenerateAsync(
                selectedFile.Name,
                selectedFile.ContentType,
                buffer.ToArray(),
                audience,
                detailMode);
        }
        catch (DeckApiException exception)
        {
            errorMessage = exception.Message;
        }
        catch (Exception)
        {
            errorMessage = "產生草稿時發生錯誤，請稍後再試。";
        }
        finally
        {
            isGenerating = false;
        }
    }

    private void AddSlide()
    {
        deck?.Slides.Add(new SlideItem
        {
            Title = "新增投影片",
            Subtitle = "補充說明",
            Content = "在這裡輸入重點內容。",
            SectionLabel = "NEW SLIDE"
        });
    }

    private void DeleteSlide(SlideItem slide)
    {
        if (deck is not null && deck.Slides.Count > 1)
        {
            deck.Slides.Remove(slide);
        }
    }

    private async Task DownloadJson()
    {
        if (deck is null)
        {
            return;
        }

        var json = JsonSerializer.Serialize(deck, new JsonSerializerOptions
        {
            WriteIndented = true
        });

        await JS.InvokeVoidAsync(
            "slideGenerator.downloadText",
            "slides.json",
            json,
            "application/json");
    }

    private async Task DownloadHtml()
    {
        if (deck is null)
        {
            return;
        }

        var html = await DeckGenerator.ExportHtmlAsync(deck);
        await JS.InvokeVoidAsync(
            "slideGenerator.downloadText",
            "presentation.html",
            html,
            "text/html");
    }

    private string BuildThemeStyle()
    {
        if (deck is null)
        {
            return string.Empty;
        }

        var theme = deck.Theme;
        return
            $"--deck-bg:{SafeColor(theme.BackgroundColor, "#F5F1E8")};" +
            $"--deck-surface:{SafeColor(theme.SurfaceColor, "#FFFFFF")};" +
            $"--deck-primary:{SafeColor(theme.PrimaryColor, "#14213D")};" +
            $"--deck-accent:{SafeColor(theme.AccentColor, "#E76F51")};" +
            $"--deck-text:{SafeColor(theme.TextColor, "#172033")};" +
            $"--deck-muted:{SafeColor(theme.MutedTextColor, "#667085")};";
    }

    private static string SafeColor(string value, string fallback) =>
        System.Text.RegularExpressions.Regex.IsMatch(
            value ?? string.Empty,
            "^#[0-9A-Fa-f]{6}$")
            ? value
            : fallback;

    private static SlideColumns SplitColumns(string content)
    {
        var lines = content
            .Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var middle = (int)Math.Ceiling(lines.Length / 2d);
        return new SlideColumns
        {
            Left = string.Join('\n', lines.Take(middle)),
            Right = string.Join('\n', lines.Skip(middle))
        };
    }

    private static void UpdateColumn(SlideItem slide, bool isLeft, string? value)
    {
        var columns = SplitColumns(slide.Content);
        if (isLeft)
        {
            columns.Left = value ?? string.Empty;
        }
        else
        {
            columns.Right = value ?? string.Empty;
        }

        slide.Content = $"{columns.Left}\n{columns.Right}".Trim();
    }

    private sealed class SlideColumns
    {
        public string Left { get; set; } = string.Empty;
        public string Right { get; set; } = string.Empty;
    }

    private static string FormatBytes(long bytes) =>
        bytes < 1024 * 1024
            ? $"{bytes / 1024d:0.0} KB"
            : $"{bytes / 1024d / 1024d:0.0} MB";
}
